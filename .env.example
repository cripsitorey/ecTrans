# PostgreSQL
POSTGRES_PASSWORD=ectrans_dev_password
DATABASE_URL=postgresql://ectrans:ectrans_dev_password@localhost:5432/ectrans

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=ectrans_minio
MINIO_SECRET_KEY=ectrans_minio_secret
MINIO_BUCKET=ectrans-documents
MINIO_USE_SSL=false

# Auth.js
AUTH_SECRET=change-me-to-a-random-32-char-string
AUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string
NEXTAUTH_URL=http://localhost:3000

# OCR thresholds
OCR_CONFIDENCE_ERROR=30
OCR_CONFIDENCE_REVIEW=60

# Worker IMAP (inactivo por defecto — ver worker/README.md)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_PEAJE_SENDERS=
IMAP_POLL_CRON=*/5 * * * *
