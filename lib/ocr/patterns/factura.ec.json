{
  "amountPatterns": [
    "(?:TOTAL|VALOR\\s+TOTAL|TOTAL\\s+A\\s+PAGAR)[:\\s]*\\$?\\s*([0-9]+[.,][0-9]{2})",
    "\\$\\s*([0-9]+[.,][0-9]{2})\\s*(?:USD)?"
  ],
  "datePatterns": [
    "([0-3]?[0-9][/-][0-1]?[0-9][/-][0-9]{4})",
    "FECHA[:\\s]*([0-3]?[0-9][/-][0-1]?[0-9][/-][0-9]{4})"
  ],
  "invoiceNumberPatterns": [
    "(?:FACTURA|No\\.?\\s*Factura|No\\.?\\s*FAC)[:\\s#]*([0-9]{3}-[0-9]{3}-[0-9]{9})",
    "(?:FACTURA|No\\.?)[:\\s#]*([0-9-]+)",
    "([0-9]{3}-[0-9]{3}-[0-9]{9})"
  ],
  "rucPatterns": [
    "R\\.?U\\.?C\\.?[:\\s]*([0-9]{13})",
    "([0-9]{13})"
  ],
  "dieselPatterns": [
    "(?:GALONES|GAL|LTS|LITROS)[:\\s]*([0-9]+[.,][0-9]*)",
    "DIESEL[:\\s]*([0-9]+[.,][0-9]*)"
  ],
  "subtotalPatterns": [
    "SUBTOTAL[:\\s]*\\$?\\s*([0-9]+[.,][0-9]{2})"
  ],
  "ivaPatterns": [
    "IVA[:\\s]*\\$?\\s*([0-9]+[.,][0-9]{2})"
  ]
}
